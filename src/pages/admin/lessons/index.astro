---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import { supabase } from '../../../utils/supabase';
import { createClient } from '@supabase/supabase-js';

const supabaseAdmin = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
  { auth: { persistSession: false } }
);

// This is admin area, we must check auth and role
const { cookies } = Astro;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
    return Astro.redirect('/login');
}

// Set session
await supabase.auth.setSession({
  access_token: accessToken.value,
  refresh_token: refreshToken.value,
});

const { data: { user } } = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect('/login');
}

const { data: profile } = await supabaseAdmin
    .from('profiles')
    .select('role')
    .eq('id', user.id)
    .single();

if (!profile || (profile.role !== 'teacher' && profile.role !== 'admin')) {
    return Astro.redirect('/dashboard?error=Acceso+Denegado');
}

const lessons = (await getCollection('lessons')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="es" data-theme="confirtheme">
<head>
    <BaseHead title="Panel de Lecciones" description="Administración de Lecciones" />
</head>
<body class="bg-base-200 min-h-screen flex flex-col font-sans">
    <Header isAdminMode={true} />
    <main class="container mx-auto px-4 max-w-6xl flex-grow py-12 animate-fade-up space-y-8">
        {/* Top Header Card */}
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 bg-base-100 p-8 rounded-3xl shadow-xl border border-base-200">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-sm mb-4">
                    <Icon name="mdi:book-open-page-variant-outline" class="w-4 h-4" />
                    Modo Administrador
                </div>
                <h2 class="text-4xl font-extrabold tracking-tight">Panel de Lecciones</h2>
                <p class="text-base-content/60 mt-2 text-lg">Crea, edita y gestiona el contenido de las lecciones semanales.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3 w-full md:w-auto justify-end">
                <button onclick="window.location.reload()" class="btn btn-outline btn-base-300 shadow-sm hover:scale-105 transition-all rounded-full px-6">
                    <Icon name="mdi:refresh" class="w-5 h-5 mr-1" />
                    Recargar
                </button>
                <a href="/admin/lessons/new" class="btn btn-primary shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all rounded-full px-8">
                    <Icon name="mdi:plus-circle-outline" class="w-5 h-5 mr-2" />
                    Crear Nueva Lección
                </a>
            </div>
        </div>

        {/* Main Content Card (Search & Table) */}
        <div class="bg-base-100 rounded-3xl shadow-2xl p-6 md:p-8 border border-base-200">
            {/* Search Input & Header */}
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-6 border-b border-base-200">
                <div>
                    <h3 class="text-xl font-bold text-base-content">Catálogo de Lecciones</h3>
                    <p class="text-sm text-base-content/60">Total de lecciones registradas: <span class="font-bold text-primary">{lessons.length}</span></p>
                </div>
                <div class="w-full sm:w-80">
                    <label class="input input-bordered flex items-center gap-2 w-full shadow-sm rounded-2xl bg-base-200/50 focus-within:bg-base-100 transition-colors">
                        <Icon name="mdi:magnify" class="w-5 h-5 text-base-content/50 shrink-0" />
                        <input 
                            type="text" 
                            id="searchInput" 
                            placeholder="Buscar por título, autor o ID..." 
                            class="grow text-sm font-medium"
                        />
                    </label>
                </div>
            </div>

            {/* Desktop View: Table */}
            <div class="overflow-x-auto hidden md:block rounded-2xl border border-base-200 shadow-sm">
                <table class="table table-zebra w-full" id="lessonsTable">
                    <thead class="bg-base-300 text-base-content text-sm">
                        <tr>
                            <th class="cursor-pointer hover:bg-base-200 transition-colors select-none py-4 w-24 whitespace-nowrap" data-sort="id">
                                <div class="flex items-center gap-1.5 font-bold">ID <Icon name="mdi:swap-vertical" class="w-4 h-4 opacity-50" /></div>
                            </th>
                            <th class="cursor-pointer hover:bg-base-200 transition-colors select-none py-4 min-w-[260px]" data-sort="title">
                                <div class="flex items-center gap-1.5 font-bold">Título <Icon name="mdi:swap-vertical" class="w-4 h-4 opacity-50" /></div>
                            </th>
                            <th class="cursor-pointer hover:bg-base-200 transition-colors select-none py-4 whitespace-nowrap min-w-[160px]" data-sort="author">
                                <div class="flex items-center gap-1.5 font-bold">Autor <Icon name="mdi:swap-vertical" class="w-4 h-4 opacity-50" /></div>
                            </th>
                            <th class="cursor-pointer hover:bg-base-200 transition-colors select-none py-4 whitespace-nowrap" data-sort="date">
                                <div class="flex items-center gap-1.5 font-bold">Fecha <Icon name="mdi:swap-vertical" class="w-4 h-4 opacity-50" /></div>
                            </th>
                            <th class="cursor-pointer hover:bg-base-200 transition-colors select-none py-4 whitespace-nowrap" data-sort="status">
                                <div class="flex items-center gap-1.5 font-bold">Estado <Icon name="mdi:swap-vertical" class="w-4 h-4 opacity-50" /></div>
                            </th>
                            <th class="text-right font-bold py-4 whitespace-nowrap min-w-[200px]">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="lessonsTableBody">
                        {lessons.map((lesson) => (
                            <tr class="hover lesson-row transition-colors" 
                                data-id={lesson.data.lessonId || lesson.id} 
                                data-title={lesson.data.title.toLowerCase()} 
                                data-author={(lesson.data.author || 'Sin autor').toLowerCase()}
                                data-date={new Date(lesson.data.pubDate).getTime()}
                                data-status={lesson.data.draft ? 'borrador' : 'publicada'}
                            >
                                <td class="whitespace-nowrap"><span class="badge badge-ghost font-mono text-xs py-3 px-3 font-bold">{lesson.data.lessonId || lesson.id}</span></td>
                                <td class="min-w-[260px]">
                                    <a href={`/lessons/${lesson.id}`} target="_blank" class="font-bold text-base text-base-content hover:text-primary transition-colors block leading-snug">
                                        {lesson.data.title}
                                    </a>
                                </td>
                                <td class="whitespace-nowrap">
                                    <div class="flex items-center gap-2 font-medium text-base-content/80">
                                        <Icon name="mdi:account-circle-outline" class="w-4 h-4 text-primary shrink-0"/> 
                                        <span>{lesson.data.author || 'Sin autor'}</span>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap">
                                    <div class="text-sm font-medium text-base-content/70 whitespace-nowrap">
                                        {new Date(lesson.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                                    </div>
                                </td>
                                <td class="whitespace-nowrap">
                                    {lesson.data.draft ? (
                                        <span class="badge badge-warning badge-md font-bold gap-1.5 shadow-2xs px-3 py-3 whitespace-nowrap inline-flex items-center">
                                            <Icon name="mdi:file-hidden" class="w-3.5 h-3.5"/> Borrador
                                        </span>
                                    ) : (
                                        <span class="badge badge-success badge-md text-white font-bold gap-1.5 shadow-2xs px-3 py-3 whitespace-nowrap inline-flex items-center">
                                            <Icon name="mdi:check-circle" class="w-3.5 h-3.5"/> Publicada
                                        </span>
                                    )}
                                </td>
                                <td class="text-right whitespace-nowrap">
                                    <div class="flex justify-end items-center gap-2">
                                        <a href={`/lessons/${lesson.id}`} target="_blank" class="btn btn-sm btn-outline btn-base-300 hover:bg-base-200 hover:border-base-300 text-base-content/80 rounded-xl font-medium gap-1.5 shadow-2xs" title="Ver lección">
                                            <Icon name="mdi:eye-outline" class="w-4 h-4 text-base-content/70" />
                                            <span class="hidden lg:inline text-xs font-medium">Ver</span>
                                        </a>
                                        <a href={`/admin/lessons/edit/${lesson.id}`} class="btn btn-sm btn-outline btn-primary rounded-xl font-bold gap-1.5 shadow-2xs hover:shadow-md transition-all" title="Editar lección">
                                            <Icon name="mdi:pencil-outline" class="w-4 h-4" />
                                            <span class="text-xs">Editar</span>
                                        </a>
                                        <button 
                                            class="btn btn-sm btn-ghost hover:bg-error/15 text-error rounded-xl ml-0.5" 
                                            title="Eliminar lección"
                                            onclick={`if(confirm('¿Seguro que deseas eliminar esta lección? Esta acción es irreversible.')) deleteLesson('${lesson.data.lessonId}', '${lesson.id}')`}
                                        >
                                            <Icon name="mdi:trash-can-outline" class="w-4 h-4" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        ))}
                        {lessons.length === 0 && (
                            <tr id="emptyRow">
                                <td colspan="6" class="text-center py-12 text-base-content/50 font-medium">
                                    No hay lecciones creadas todavía.
                                </td>
                            </tr>
                        )}
                        <tr id="noResultsRow" class="hidden">
                            <td colspan="6" class="text-center py-12 text-base-content/50 font-medium">
                                No se encontraron lecciones que coincidan con la búsqueda.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {/* Mobile View: Cards */}
            <div class="grid grid-cols-1 gap-4 md:hidden" id="lessonsMobileList">
                {lessons.map((lesson) => (
                    <div class="bg-base-100 p-5 rounded-2xl border border-base-200 shadow-sm flex flex-col gap-4 lesson-card hover:shadow-md transition-all hover:border-primary/20"
                         data-id={lesson.data.lessonId || lesson.id} 
                         data-title={lesson.data.title.toLowerCase()} 
                         data-author={(lesson.data.author || 'Sin autor').toLowerCase()}
                    >
                        <div class="flex justify-between items-start gap-3">
                            <div class="space-y-1">
                                <span class="badge badge-ghost font-mono text-[11px] font-bold uppercase tracking-wider">ID: {lesson.data.lessonId || lesson.id}</span>
                                <h3 class="font-extrabold text-base text-base-content leading-snug">{lesson.data.title}</h3>
                                <p class="text-xs text-base-content/70 flex items-center gap-1.5 pt-0.5 font-medium">
                                    <Icon name="mdi:account-circle-outline" class="w-4 h-4 text-primary"/> 
                                    {lesson.data.author || 'Sin autor'}
                                </p>
                            </div>
                            {lesson.data.draft ? (
                                <span class="badge badge-warning badge-sm font-bold shrink-0 shadow-2xs">Borrador</span>
                            ) : (
                                <span class="badge badge-success badge-sm text-white font-bold shrink-0 shadow-2xs">Publicada</span>
                            )}
                        </div>
                        
                        <div class="flex justify-between items-center border-t border-base-200/80 pt-3.5">
                            <span class="text-xs text-base-content/60 font-medium flex items-center gap-1">
                                <Icon name="mdi:calendar-blank-outline" class="w-3.5 h-3.5"/>
                                {new Date(lesson.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                            </span>
                            <div class="flex items-center gap-2">
                                <a href={`/lessons/${lesson.id}`} target="_blank" class="btn btn-sm btn-outline btn-base-300 hover:bg-base-200 hover:border-base-300 text-base-content/80 rounded-xl gap-1.5" title="Ver lección">
                                    <Icon name="mdi:eye-outline" class="w-4 h-4 text-base-content/70" />
                                    <span class="text-xs font-medium">Ver</span>
                                </a>
                                <a href={`/admin/lessons/edit/${lesson.id}`} class="btn btn-sm btn-outline btn-primary rounded-xl font-bold gap-1.5" title="Editar lección">
                                    <Icon name="mdi:pencil-outline" class="w-4 h-4" />
                                    <span class="text-xs">Editar</span>
                                </a>
                                <button 
                                    class="btn btn-sm btn-ghost hover:bg-error/15 text-error rounded-xl ml-0.5" 
                                    title="Eliminar lección"
                                    onclick={`if(confirm('¿Seguro que deseas eliminar esta lección? Esta acción es irreversible.')) deleteLesson('${lesson.data.lessonId}', '${lesson.id}')`}
                                >
                                    <Icon name="mdi:trash-can-outline" class="w-4 h-4" />
                                </button>
                            </div>
                        </div>
                    </div>
                ))}
                {lessons.length === 0 && (
                    <div class="text-center py-12 text-base-content/50 bg-base-100 rounded-2xl border border-base-200 font-medium">
                        No hay lecciones creadas todavía.
                    </div>
                )}
                <div id="noResultsCard" class="hidden text-center py-12 text-base-content/50 bg-base-100 rounded-2xl border border-base-200 font-medium">
                    No se encontraron lecciones que coincidan con la búsqueda.
                </div>
            </div>
        </div>
    </main>
    <Footer />

    <script is:inline>
        async function deleteLesson(id, slug) {
            try {
                const res = await fetch(`/api/admin/lessons?id=${id}&slug=${slug}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    alert('Lección eliminada correctamente.');
                    window.location.reload();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (err) {
                console.error(err);
                alert('Ocurrió un error de red.');
            }
        }

        // Search and Sort Logic
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            
            // Search logic
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const term = e.target.value.toLowerCase();
                    
                    // Filter table rows
                    const rows = document.querySelectorAll('.lesson-row');
                    let visibleRows = 0;
                    rows.forEach(row => {
                        const id = row.getAttribute('data-id') || '';
                        const title = row.getAttribute('data-title') || '';
                        const author = row.getAttribute('data-author') || '';
                        
                        if (id.includes(term) || title.includes(term) || author.includes(term)) {
                            row.style.display = '';
                            visibleRows++;
                        } else {
                            row.style.display = 'none';
                        }
                    });
                    
                    const noResultsRow = document.getElementById('noResultsRow');
                    if (noResultsRow) {
                        noResultsRow.style.display = (visibleRows === 0 && rows.length > 0) ? '' : 'none';
                    }

                    // Filter mobile cards
                    const cards = document.querySelectorAll('.lesson-card');
                    let visibleCards = 0;
                    cards.forEach(card => {
                        const id = card.getAttribute('data-id') || '';
                        const title = card.getAttribute('data-title') || '';
                        const author = card.getAttribute('data-author') || '';
                        
                        if (id.includes(term) || title.includes(term) || author.includes(term)) {
                            card.style.display = '';
                            visibleCards++;
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    const noResultsCard = document.getElementById('noResultsCard');
                    if (noResultsCard) {
                        noResultsCard.style.display = (visibleCards === 0 && cards.length > 0) ? 'block' : 'none';
                    }
                });
            }

            // Sort logic
            const tableHeaders = document.querySelectorAll('th[data-sort]');
            let currentSort = { column: 'date', asc: false };

            tableHeaders.forEach(th => {
                th.addEventListener('click', () => {
                    const column = th.getAttribute('data-sort');
                    const isAsc = currentSort.column === column ? !currentSort.asc : true;
                    currentSort = { column, asc: isAsc };
                    
                    const tbody = document.getElementById('lessonsTableBody');
                    const rows = Array.from(tbody.querySelectorAll('.lesson-row'));
                    
                    rows.sort((a, b) => {
                        let valA = a.getAttribute(`data-${column}`);
                        let valB = b.getAttribute(`data-${column}`);
                        
                        if (column === 'date' || column === 'id') {
                            valA = Number(valA) || 0;
                            valB = Number(valB) || 0;
                            return isAsc ? valA - valB : valB - valA;
                        } else {
                            return isAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
                        }
                    });
                    
                    rows.forEach(row => tbody.appendChild(row));
                });
            });
        });
    </script>
</body>
</html>
