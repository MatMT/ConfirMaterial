---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import LessonEditor from "../../../components/react/admin/LessonEditor";
import { Icon } from "astro-icon/components";

import { supabase } from "../../../utils/supabase";
import { createClient } from "@supabase/supabase-js";

const supabaseAdmin = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
    { auth: { persistSession: false } },
);

// This is admin area, we must check auth and role
const { cookies } = Astro;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
    return Astro.redirect("/login");
}

// Set session
await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
});

const {
    data: { user },
} = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect("/login");
}

const { data: profile } = await supabaseAdmin
    .from("profiles")
    .select("*")
    .eq("id", user.id)
    .single();

if (!profile || (profile.role !== "teacher" && profile.role !== "admin")) {
    return Astro.redirect("/dashboard?error=Acceso+Denegado");
}

const defaultAuthor =
    [profile.first_name, profile.last_name].filter(Boolean).join(" ") ||
    profile.full_name ||
    profile.username ||
    user.email?.split("@")[0] ||
    "Autor";
---

<html lang="es" data-theme="confirtheme">
    <head>
        <BaseHead title="Nueva Lección" description="Crear nueva lección" />
    </head>
    <body class="bg-base-200 min-h-screen flex flex-col font-sans">
        <Header isAdminMode={true} />
        <main class="container mx-auto px-4 max-w-4xl flex-grow py-3 sm:py-6 animate-fade-up space-y-3 sm:space-y-4">
            {/* Header Plano Ultracompacto (~48px) */}
            <div class="flex items-center justify-between gap-3 bg-base-100 px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-2xl shadow-sm border border-base-200">
                <div class="flex items-center gap-2 min-w-0">
                    <a 
                        href="/admin/lessons" 
                        class="btn btn-ghost btn-sm btn-circle text-slate-500 hover:text-slate-800"
                        title="Volver al panel de lecciones"
                        aria-label="Volver al panel"
                    >
                        <Icon name="mdi:arrow-left" class="w-5 h-5" />
                    </a>
                    <div class="min-w-0">
                        <span class="text-[10px] sm:text-xs text-primary font-bold block leading-none mb-0.5">Modo Administrador</span>
                        <h1 class="text-sm sm:text-base md:text-lg font-bold text-slate-800 truncate leading-tight">
                            Crear Nueva Lección
                        </h1>
                    </div>
                </div>
            </div>

            <LessonEditor
                client:load
                initialData={{ author: defaultAuthor }}
            />
        </main>
        <Footer />
    </body>
</html>
