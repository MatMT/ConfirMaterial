---
export const prerender = false;
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { createClient } from "@supabase/supabase-js";
import StudentsTable from '../../components/react/admin/StudentsTable';
import { Icon } from 'astro-icon/components';
import { getStreakStatus } from '../../utils/streakHelper';
import { getCollection } from 'astro:content';
import { fetchFromGitHub } from '../../utils/github';
import HolidayToggle from '../../components/react/admin/HolidayToggle';

import { supabase } from '../../utils/supabase';
import { isAdminMode } from '../../utils/admin';

// Inicializar cliente admin para saltar RLS
const supabaseAdmin = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
    { auth: { persistSession: false } }
);

// Autenticación Real de Supabase (o Bypass si ADMIN_MODE está activo)
const { cookies } = Astro;
const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");
const adminBypass = isAdminMode();

if (!adminBypass && (!accessToken || !refreshToken)) {
    return Astro.redirect('/login');
}

if (accessToken && refreshToken) {
    await supabase.auth.setSession({
        access_token: accessToken.value,
        refresh_token: refreshToken.value,
    });
}

const { data: { user } } = await supabase.auth.getUser();

if (!adminBypass && !user) {
    return Astro.redirect('/login');
}

let profile = null;
if (user) {
    const { data: profileData } = await supabaseAdmin
        .from('profiles')
        .select('role')
        .eq('id', user.id)
        .single();
    profile = profileData;
}

if (!adminBypass && (!profile || (profile.role !== 'teacher' && profile.role !== 'admin'))) {
    return Astro.redirect('/dashboard?error=Acceso+Denegado');
}

const isAuthenticated = true;


let isHolidayMode = false;
try {
    const fileData = await fetchFromGitHub('src/content/data/settings.json');
    if (fileData && fileData.content) {
        const jsonStr = Buffer.from(fileData.content, 'base64').toString('utf-8');
        const settings = JSON.parse(jsonStr);
        isHolidayMode = !!settings.holidayMode;
    }
} catch (e) {}

const allLessons = await getCollection('lessons', ({ data }) => !data.draft);
let latestLessonDate = null;
if (allLessons && allLessons.length > 0) {
    const maxTime = Math.max(...allLessons.map(l => new Date(l.data.pubDate).getTime()));
    latestLessonDate = new Date(maxTime).toISOString();
}

let students = [];
if (isAuthenticated) {
    const { data, error } = await supabaseAdmin
        .from('profiles')
        .select('*')
        .eq('role', 'student')
        .order('created_at', { ascending: false });
    
    if (data) {
        const { data: streaksData } = await supabaseAdmin
            .from('user_streaks')
            .select('*');
        
        students = await Promise.all(data.map(async (student) => {
            const streak = streaksData?.find(s => s.user_id === student.id);
            const rawStreak = streak?.current_streak || 0;
            const lastDate = streak?.last_lesson_date || null;
            const status = getStreakStatus(rawStreak, lastDate, latestLessonDate, isHolidayMode);
            
            if (rawStreak > 0 && status.streak === 0 && !status.isFrozen) {
                await supabaseAdmin
                    .from('user_streaks')
                    .update({ current_streak: 0 })
                    .eq('user_id', student.id);
            }

            return {
                ...student,
                streak: status.streak,
                isFrozen: status.isFrozen,
                freezeReason: status.reason,
                longestStreak: streak?.longest_streak || 0,
                last_connection: lastDate || student.created_at
            };
        }));
    }
}
---

<!DOCTYPE html>
<html lang="es" data-theme="confirtheme">
<head>
    <BaseHead title="Panel de Administración" description="Administración de alumnos" />
</head>
<body class="bg-base-200 min-h-screen flex flex-col font-sans">
    
    <Header isAdminMode={true} />

    <main class="container mx-auto px-4 max-w-6xl flex-grow py-12 animate-fade-up">
        <div class="space-y-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 bg-base-100 p-8 rounded-3xl shadow-xl border border-base-200">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-sm mb-4">
                        <Icon name="mdi:shield-check" class="w-4 h-4" />
                        Modo Administrador
                    </div>
                    <h2 class="text-4xl font-extrabold tracking-tight">Gestión de Alumnos</h2>
                    <p class="text-base-content/60 mt-2 text-lg">Supervisa el progreso y las rachas de todos los estudiantes.</p>
                </div>
                <a href="/admin/students/new" class="btn btn-primary shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all rounded-full px-8">
                    <Icon name="mdi:account-plus-outline" class="w-5 h-5 mr-2" />
                    Crear Nuevo Alumno
                </a>
            </div>
            
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-base-100 p-4 sm:p-6 rounded-3xl shadow-md border border-base-200">
                <div class="flex items-center gap-2">
                    <span class="text-base font-extrabold text-base-content/80">Control Global de Rachas:</span>
                </div>
                <HolidayToggle client:load initialHolidayMode={isHolidayMode} />
            </div>
            
            <div className="bg-base-100 rounded-3xl shadow-2xl p-6 md:p-8 border border-base-200">
                <StudentsTable client:load students={students} />
            </div>
        </div>
    </main>

    <Footer />
</body>
</html>
