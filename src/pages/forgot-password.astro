---
export const prerender = false;
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const { url } = Astro;
const errorMsg = url.searchParams.get("error");
const isSent = url.searchParams.get("sent") === "true";
---

<!doctype html>
<html lang="es" data-theme="confirtheme">
  <head>
    <BaseHead
      title={`Recuperar Contraseña | ${SITE_TITLE}`}
      description="Recuperación de contraseña para alumnos y profesores"
    />
  </head>
  <body class="min-h-screen bg-base-200 flex flex-col justify-center items-center p-4">
    <div class="toast toast-top toast-end z-[100] w-full max-w-md" id="alertToast">
      {isSent && (
        <div class="alert alert-success shadow-2xl flex justify-between rounded-lg text-white border-none animate-fade-down">
          <div class="flex items-start gap-3">
            <div>
              <h3 class="font-bold text-white">¡Correo Enviado!</h3>
              <div class="text-sm mt-1 text-white/90">
                Hemos enviado las instrucciones para restablecer tu contraseña. Por favor revisa tu bandeja de entrada o la carpeta de Spam / Correo no deseado.
              </div>
            </div>
          </div>
          <button class="btn btn-ghost btn-sm btn-circle text-white" onclick="document.getElementById('alertToast').style.display='none'">✕</button>
        </div>
      )}

      {errorMsg && (
        <div class="alert alert-error shadow-2xl flex justify-between rounded-lg text-white border-none animate-fade-down">
          <div class="flex items-start gap-3">
            <div>
              <h3 class="font-bold text-white">Atención</h3>
              <div class="text-sm mt-1 text-white/90">{errorMsg}</div>
            </div>
          </div>
          <button class="btn btn-ghost btn-sm btn-circle text-white" onclick="document.getElementById('alertToast').style.display='none'">✕</button>
        </div>
      )}
    </div>

    <div class="card w-full max-w-lg shadow-2xl bg-base-100 animate-fade-down animate-duration-500">
      <div class="card-body p-6 sm:p-8">
        <div class="text-center mb-6">
          <h1 class="text-2xl sm:text-3xl font-bold text-primary">Recuperar Acceso</h1>
          <p class="text-sm text-base-content/70 mt-2">
            Selecciona tu tipo de cuenta para recibir ayuda
          </p>
        </div>

        <!-- Pestañas de Alumno vs Profesor -->
        <div role="tablist" class="tabs tabs-boxed bg-base-200 p-1 rounded-xl mb-6 grid grid-cols-2">
          <a role="tab" class="tab tab-active font-bold transition-all text-xs sm:text-sm py-2 h-auto" onclick="switchTab('student')">
            🎓 Soy Alumno
          </a>
          <a role="tab" class="tab font-bold transition-all text-xs sm:text-sm py-2 h-auto" onclick="switchTab('teacher')">
            👨‍🏫 Soy Profesor / Admin
          </a>
        </div>

        <!-- Contenido Tab 1: Alumno -->
        <div id="tab-student" class="space-y-4 animate-fade">
          <div class="bg-warning/10 border border-warning/30 p-4 rounded-2xl flex gap-4 items-start">
            <div class="text-2xl">💡</div>
            <div>
              <h3 class="font-bold text-warning-content">Los alumnos no usan correo electrónico</h3>
              <p class="text-xs sm:text-sm text-base-content/80 mt-1 leading-relaxed">
                Por seguridad y privacidad, las cuentas de alumnos se gestionan mediante su <strong class="font-mono bg-base-200 px-1 rounded">Credencial (ej. EL231027)</strong> sin correo vinculado.
              </p>
            </div>
          </div>

          <div class="bg-base-200/60 p-5 rounded-2xl space-y-3 border border-base-300/50">
            <h4 class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="badge badge-primary badge-sm">Paso Único</span> ¿Cómo recupero mi contraseña?
            </h4>
            <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed">
              Comunícate directamente con tu <strong>Catequista o Profesor</strong> de grupo e indícale tu nombre completo o credencial. Tu profesor entrará al Panel de Administración y te asignará una nueva contraseña en segundos.
            </p>
          </div>

          <div class="pt-4">
            <a href="/login" class="btn btn-outline btn-primary w-full font-bold">
              Volver al Inicio de Sesión
            </a>
          </div>
        </div>

        <!-- Contenido Tab 2: Profesor -->
        <div id="tab-teacher" class="space-y-4 animate-fade hidden">
          <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed">
            Ingresa la dirección de correo electrónico con la que te registraste. Te enviaremos un enlace seguro para que puedas restablecer tu contraseña.
          </p>

          <form action="/api/auth/forgot-password" method="POST" class="space-y-4">
            <div class="form-control">
              <label class="label" for="email">
                <span class="label-text font-semibold">Correo Electrónico</span>
              </label>
              <input
                type="email"
                name="email"
                id="email"
                placeholder="profesor@correo.com"
                class="input input-bordered w-full"
                required
              />
            </div>

            <button type="submit" class="btn btn-primary w-full font-bold shadow-md">
              Enviar Enlace de Recuperación
            </button>
          </form>

          <div class="pt-2 text-center">
            <a href="/login" class="link link-hover text-xs text-base-content/60">
              Cancelar y volver al inicio
            </a>
          </div>
        </div>

      </div>
    </div>

    <script>
      function switchTab(type) {
        const tabs = document.querySelectorAll('[role="tab"]');
        const studentTab = document.getElementById('tab-student');
        const teacherTab = document.getElementById('tab-teacher');

        if (type === 'student') {
          tabs[0].classList.add('tab-active');
          tabs[1].classList.remove('tab-active');
          studentTab.classList.remove('hidden');
          teacherTab.classList.add('hidden');
        } else {
          tabs[1].classList.add('tab-active');
          tabs[0].classList.remove('tab-active');
          teacherTab.classList.remove('hidden');
          studentTab.classList.add('hidden');
        }
      }
      window.switchTab = switchTab;
    </script>
  </body>
</html>
