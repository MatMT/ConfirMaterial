---
export const prerender = false;
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="es" data-theme="confirtheme">
  <head>
    <BaseHead
      title={`Crear Nueva Contraseña | ${SITE_TITLE}`}
      description="Crear una nueva contraseña de acceso"
    />
  </head>
  <body class="min-h-screen bg-base-200 flex flex-col justify-center items-center p-4">
    <div class="toast toast-top toast-end z-[100] w-full max-w-md" id="alertToast"></div>

    <div class="card w-full max-w-md shadow-2xl bg-base-100 animate-fade-down animate-duration-500">
      <div class="card-body p-6 sm:p-8">
        <div class="text-center mb-6">
          <h1 class="text-2xl sm:text-3xl font-bold text-primary">Nueva Contraseña</h1>
          <p class="text-sm text-base-content/70 mt-2">
            Ingresa tu nueva contraseña para recuperar el acceso a tu cuenta
          </p>
        </div>

        <form id="resetForm" class="space-y-4">
          <div class="form-control">
            <label class="label" for="newPassword">
              <span class="label-text font-semibold">Nueva Contraseña</span>
            </label>
            <input
              type="password"
              id="newPassword"
              placeholder="••••••••"
              minlength="6"
              class="input input-bordered w-full"
              required
            />
          </div>

          <div class="form-control">
            <label class="label" for="confirmPassword">
              <span class="label-text font-semibold">Confirmar Contraseña</span>
            </label>
            <input
              type="password"
              id="confirmPassword"
              placeholder="••••••••"
              minlength="6"
              class="input input-bordered w-full"
              required
            />
          </div>

          <button type="submit" id="submitBtn" class="btn btn-primary w-full font-bold shadow-md mt-4">
            Restablecer Contraseña
          </button>
        </form>

        <div class="pt-4 text-center">
          <a href="/login" class="link link-hover text-xs text-base-content/60">
            Volver al Inicio de Sesión
          </a>
        </div>
      </div>
    </div>

    <script>
      import { supabase } from "../utils/supabase";

      const form = document.getElementById("resetForm");
      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
      const alertToast = document.getElementById("alertToast");

      function showAlert(msg, isSuccess = false) {
        if (!alertToast) return;
        alertToast.innerHTML = `
          <div class="alert ${isSuccess ? 'alert-success' : 'alert-error'} shadow-2xl flex justify-between rounded-lg text-white border-none animate-fade-down">
            <div class="flex items-start gap-3">
              <div>
                <h3 class="font-bold text-white">${isSuccess ? '¡Éxito!' : 'Error'}</h3>
                <div class="text-sm mt-1 text-white/90">${msg}</div>
              </div>
            </div>
            <button class="btn btn-ghost btn-sm btn-circle text-white" onclick="document.getElementById('alertToast').innerHTML=''">✕</button>
          </div>
        `;
      }

      // Verificar al cargar si el enlace expiró o es inválido en la URL
      document.addEventListener("DOMContentLoaded", () => {
        const hashOrSearch = window.location.hash || window.location.search;
        if (hashOrSearch.includes("error=access_denied") || hashOrSearch.includes("otp_expired") || hashOrSearch.includes("error_code")) {
          showAlert("⚠️ Este enlace de recuperación ha expirado o ya fue utilizado. Por favor, solicita un nuevo enlace desde ¿Olvidaste tu contraseña?");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerText = "Enlace Expirado";
          }
          if (form) form.style.opacity = "0.5";
        }
      });

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const newPassEl = document.getElementById("newPassword") as HTMLInputElement;
          const confirmPassEl = document.getElementById("confirmPassword") as HTMLInputElement;
          
          if (!newPassEl || !confirmPassEl || !submitBtn) return;

          const newPass = newPassEl.value;
          const confirmPass = confirmPassEl.value;

          if (newPass !== confirmPass) {
            showAlert("Las contraseñas no coinciden.");
            return;
          }

          if (newPass.length < 6) {
            showAlert("La contraseña debe tener al menos 6 caracteres.");
            return;
          }

          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="loading loading-spinner"></span> Actualizando...';

          try {
            const { error } = await supabase.auth.updateUser({ password: newPass });
            if (error) {
              showAlert("Error al actualizar la contraseña: " + error.message);
              submitBtn.disabled = false;
              submitBtn.innerText = "Restablecer Contraseña";
            } else {
              showAlert("¡Contraseña restablecida exitosamente! Redirigiendo...", true);
              setTimeout(() => {
                window.location.href = "/login";
              }, 2000);
            }
          } catch (err) {
            showAlert("Error de red al intentar actualizar la contraseña.");
            submitBtn.disabled = false;
            submitBtn.innerText = "Restablecer Contraseña";
          }
        });
      }
    </script>
  </body>
</html>
